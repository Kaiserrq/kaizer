# Copia este archivo a .env.local (ignorado por git) y pon tu key de Gemini.
# Solo la lee el servidor (función /api/chat); nunca llega al navegador.
GEMINI_API_KEY=
# Opcional: límite de peticiones por IP y día (por defecto 40).
# RATE_LIMIT_PER_DAY=40
# Opcional: tope diario global de la demo (por defecto 600).
# RATE_LIMIT_GLOBAL_PER_DAY=600
